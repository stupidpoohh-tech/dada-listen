# Neon 콘솔에서 복사.
#   Auth      → VITE_NEON_AUTH_URL
#   Data API  → VITE_NEON_DATA_API_URL
# 둘 다 브라우저에 노출되는 값이다. 실제 권한은 RLS 가 담당한다.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=

# 미디어 서명 URL 발급 API. 같은 오리진에 배포하면 비워둬도 된다.
VITE_MEDIA_API_URL=

# 아래는 절대 여기에 넣지 않는다.
# Cloudflare Worker 비밀로만 설정한다 — `wrangler secret put <이름>`.
#   NEON_DATABASE_URL    전사 결과 저장 + 마이그레이션 적용
#   DEEPGRAM_API_KEY     전사
#   MEDIA_TOKEN_SECRET   미디어 URL 서명
#
# R2 access key / secret key 는 필요 없다. Worker 가 바인딩으로 붙는다
# (wrangler.toml 의 [[r2_buckets]]). 자세한 절차는 docs/setup.md.
