# Neon 콘솔에서 복사.
#   Auth      → VITE_NEON_AUTH_URL
#   Data API  → VITE_NEON_DATA_API_URL
# 둘 다 브라우저에 노출되는 값이다. 실제 권한은 RLS 가 담당한다.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=

# 미디어 서명 URL 발급 API. 같은 오리진에 배포하면 비워둬도 된다.
VITE_MEDIA_API_URL=

# 아래는 절대 여기에 넣지 않는다 (서버 함수 시크릿으로만 설정):
#   NEON_DATABASE_URL          마이그레이션 적용용 직접 연결 문자열
#   R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY
#   DEEPGRAM_API_KEY
